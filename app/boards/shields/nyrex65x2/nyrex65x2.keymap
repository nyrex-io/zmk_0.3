#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
//#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
&kp ESC     &kp N1          &kp N2          &kp N3              &kp N4      &kp N5      &kp N6      &kp N7  &kp N8  &kp N9      &kp N0      &kp MINUS   &kp EQUAL   &kp BSPC    &kp BSPC    &kp HOME
&kp TAB     &kp Q           &kp W           &kp E               &kp R       &kp T                   &kp Y   &kp U   &kp I       &kp O       &kp P       &kp LBKT    &kp RBKT    &kp DEL     &kp END
&kp LCTRL   &kp A           &kp S           &kp D               &kp F       &kp G                           &kp H   &kp J       &kp K       &kp L       &kp SEMI    &kp SQT     &kp ENTER   &kp PG_UP
&kp LSHFT   &kp LSHFT       &kp Z           &kp X               &kp C       &kp V       &kp B               &kp N   &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT   &kp UP      &kp PG_DN
&kp LCTRL   &mo 1           &kp LGUI        &kp LALT            &kp SPACE                                           &kp SPACE   &mo 1       &kp RGUI    &kp RALT    &kp LEFT    &kp DOWN    &kp RIGHT
            >;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
&kp GRAVE   &kp F1          &kp F2          &kp F3              &kp F4          &kp F5      &kp F6      &kp F7  &kp F8  &kp F9      &kp F10     &kp F11     &kp F12     &bootloader      &studio_unlock      &kp C_NEXT
&trans    &ext_power EP_TOG &kp HOME        &kp UP              &kp END         &kp PG_UP               &trans  &trans  &trans      &trans      &trans      &trans      &trans      &kp BSLH    &kp C_PREV 
&trans      &kp CAPS        &kp LEFT        &kp DOWN            &kp RIGHT       &kp PG_DN                       &trans  &trans      &trans      &trans      &trans      &trans      &trans      &kp C_MUTE
&trans      &trans          &bt BT_SEL 0    &bt BT_SEL 1        &bt BT_SEL 2    &bt BT_CLR  &out OUT_TOG        &trans  &trans      &trans      &trans      &trans      &trans      &trans      &kp C_PP
&trans      &trans          &trans          &trans              &trans                                          &trans      &trans      &trans      &trans      &trans      &trans      &trans 
            >;
        };

        extra1{
            status = "reserved";
        };

        extra2{
            status = "reserved";
        };
        
        extra3{
            status = "reserved";
        };

        extra4{
            status = "reserved";
        };
        
        extra5{
            status = "reserved";
        };
    };
};